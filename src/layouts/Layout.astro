---
interface Props { title?: string; }
const { title = 'Selene Grand — A Residence Among the Stars' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content="Two hundred and thirty-eight thousand miles from Earth. The Selene Grand — a residence among the stars on Mare Tranquillitatis." />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><circle cx='16' cy='16' r='14' fill='%230A0A0F' stroke='%23B89968' stroke-width='1.5'/><circle cx='16' cy='16' r='7' fill='none' stroke='%23B89968' stroke-width='0.8' opacity='0.6'/><circle cx='16' cy='16' r='2.5' fill='%23B89968'/></svg>" />

  <!-- Open Graph -->
  <meta property="og:type"        content="website" />
  <meta property="og:title"       content="Selene Grand — A Residence Among the Stars" />
  <meta property="og:description" content="Two hundred and thirty-eight thousand miles from Earth. The Selene Grand." />
  <meta property="og:image"       content="/images/hero.jpg" />
  <meta name="twitter:card"       content="summary_large_image" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;1,300;1,400&family=Inter:wght@200;300;400&display=swap" rel="stylesheet" />
</head>
<body>

  <!-- Custom cursor -->
  <div id="cursor" aria-hidden="true"></div>
  <div id="cursor-dot" aria-hidden="true"></div>

  <!-- WebGL nebula — fullscreen, z-index 0 -->
  <canvas id="nebula-canvas" aria-hidden="true"></canvas>

  <!-- Film grain overlay — 24fps canvas, mix-blend-mode overlay -->
  <canvas id="grain-canvas" aria-hidden="true"></canvas>

  <!-- Intro sequence overlay -->
  <div id="intro-overlay" aria-hidden="true">
    <div id="intro-orb"></div>
    <div id="intro-text">
      <div id="intro-selene">SELENE</div>
      <div id="intro-rule"></div>
      <div id="intro-grand">GRAND</div>
    </div>
  </div>

  <!-- Sovereign Residence Easter Egg overlay -->
  <div id="sovereign-overlay" aria-hidden="true" role="dialog" aria-label="The Sovereign Residence">
    <button class="sovereign-close" id="sovereign-close" aria-label="Close">Dismiss</button>
    <div class="sovereign-inner">
      <div class="sovereign-eyebrow">Undisclosed &middot; By Introduction Only</div>
      <h2 class="sovereign-name">The Sovereign<br />Residence</h2>
      <div class="sovereign-rule"></div>
      <p class="sovereign-desc">
        Not listed. Not priced. A single accommodation exists above the Apollo
        Residence — the original construction chamber, repurposed. It has no
        name in our catalogue because it has no equal. Inquiries reach Geneva
        by private correspondence only.
      </p>
      <div class="sovereign-price">Contact Geneva &middot; By arrangement</div>
    </div>
  </div>

  <slot />

  <script>
    import '../scripts/main.js';
  </script>
</body>
</html>
